{
  "name": "trade-winds",
  "productName": "Trade Winds",
  "version": "0.19.1",
  "description": "A story-driven Caribbean career for Microsoft Flight Simulator",
  "main": "main.js",
  "author": "Trade Winds",
  "license": "UNLICENSED",
  "tradeWinds": { "feed": "https://raw.githubusercontent.com/ryanbaseball761-lab/winds/main/" },
  "private": true,
  "scripts": {
    "game": "node -e \"require('fs').mkdirSync('game',{recursive:true});require('fs').copyFileSync('../index.html','game/index.html')\"",
    "start": "npm run game && electron .",
    "dist": "npm run game && electron-builder --win nsis"
  },
  "dependencies": {
    "node-simconnect": "^4.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.tradewinds.app",
    "productName": "Trade Winds",
    "artifactName": "TradeWinds-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "sim-core.js", "companion.html", "panel.html", "game/index.html", "build/icon.png", "package.json"],
    "extraResources": [{ "from": "msfs-panel", "to": "msfs-panel", "filter": ["**/*", "!**/Build/Packages/**", "!**/Build/_PackageInt/**"] }],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Trade Winds" }
  }
}
